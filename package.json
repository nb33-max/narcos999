    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "node-telegram-bot-api": "^0.66.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "lucide-react": "^0.447.0",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "recharts": "^2.13.3",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.10"
