{
  "name": "narcos-bay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NARCOS BAY — storefront, admin command center, and Telegram bot (Vercel-ready monorepo)",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "vite build frontend",
