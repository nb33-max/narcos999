# Copy this file to backend/.env (local dev) or set as Environment Variables
# in Vercel. Everything below is REQUIRED for the app to run.

# Supabase (products, users, orders, analytics, stories, telegram data)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Cloudinary (product/story media + uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-key
CLOUDINARY_API_SECRET=your-secret

# Telegram bot
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_BOT_ID=your-bot-id
TELEGRAM_ADMIN_ID=your-admin-user-id

# Secret used to sign admin/customer session tokens.
# Generate one locally with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use the SAME value everywhere (local .env + Vercel).
AUTH_SECRET=generate-a-random-64-char-hex-string
